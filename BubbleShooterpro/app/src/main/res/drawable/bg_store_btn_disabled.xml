<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Bottom Shadow -->
    <item
        android:top="2dp"
        android:left="0dp"
        android:right="0dp"
        android:bottom="0dp">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#475569" />
        </shape>
    </item>

    <!-- 3D Bevel Rim -->
    <item
        android:top="0dp"
        android:left="0dp"
        android:right="0dp"
        android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#64748B" />
        </shape>
    </item>

    <!-- Surface Face -->
    <item
        android:top="0dp"
        android:left="0dp"
        android:right="0dp"
        android:bottom="3dp">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#94A3B8" />
        </shape>
    </item>
</layer-list>
