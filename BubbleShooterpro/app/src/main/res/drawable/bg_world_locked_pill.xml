<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer Drop Shadow -->
    <item
        android:top="@dimen/dp_3">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/dp_20" />
            <solid android:color="#60000000" />
        </shape>
    </item>

    <!-- Base 3D Border -->
    <item android:bottom="@dimen/dp_2">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/dp_20" />
            <solid android:color="#78350F" />
            <stroke
                android:width="@dimen/dp_2"
                android:color="#F59E0B" />
        </shape>
    </item>

    <!-- Inner Face Gradient -->
    <item
        android:bottom="@dimen/dp_4"
        android:top="@dimen/dp_2"
        android:start="@dimen/dp_2"
        android:end="@dimen/dp_2">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/dp_18" />
            <gradient
                android:startColor="#B45309"
                android:centerColor="#78350F"
                android:endColor="#451A03"
                android:angle="270" />
        </shape>
    </item>
</layer-list>
