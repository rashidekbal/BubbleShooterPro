<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- The Custom Canvas Game View (Fills full screen) -->
    <com.redcodersgroup.bubbleshooter.ui.BubbleGameView
        android:id="@+id/bubbleGameView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top HUD Overlay (Cleanly positioned above ceiling line with camera cutout safe padding) -->
    <LinearLayout
        android:id="@+id/topHud"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:clipToPadding="false"
        android:clipChildren="false"
        android:paddingStart="@dimen/dp_12"
        android:paddingEnd="@dimen/dp_12"
        android:paddingTop="@dimen/dp_36"
        android:paddingBottom="@dimen/dp_10">

        <!-- Pause Button -->
        <ImageButton
            android:id="@+id/btnPause"
            android:layout_width="@dimen/dp_46"
            android:layout_height="@dimen/dp_46"
            android:background="@android:color/transparent"
            android:scaleType="fitCenter"
            android:src="@drawable/btn_pause_yellow"
            android:contentDescription="Pause" />

        <!-- Star Stage Progress and Level/Score Info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginStart="@dimen/dp_10"
            android:layout_marginEnd="@dimen/dp_10">

            <!-- Top Row: Level Badge Pill + Score -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvLevelTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge_level_pill"
                    android:paddingStart="@dimen/dp_8"
                    android:paddingEnd="@dimen/dp_8"
                    android:paddingTop="@dimen/dp_2"
                    android:paddingBottom="@dimen/dp_2"
                    android:text="LVL 1"
                    android:textColor="#FFFFFF"
                    android:textSize="@dimen/sp_11"
                    android:textStyle="bold"
                    android:letterSpacing="0.05" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="@dimen/dp_1"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/tvScore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SCORE: 0"
                    android:textColor="@color/accent_yellow"
                    android:textSize="@dimen/sp_13"
                    android:textStyle="bold"
                    android:shadowColor="#80000000"
                    android:shadowDx="1"
                    android:shadowDy="1"
                    android:shadowRadius="2" />
            </LinearLayout>

            <!-- Bottom Row: Star Stage Progress Bar Track + 3 Milestone Nodes -->
            <FrameLayout
                android:id="@+id/layoutStarProgressTrack"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_22"
                android:layout_marginTop="@dimen/dp_3">

                <ProgressBar
                    android:id="@+id/pbStarProgress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_10"
                    android:layout_gravity="center_vertical"
                    android:max="1000"
                    android:progress="0"
                    android:progressDrawable="@drawable/progress_star_stage_track" />

                <!-- Milestone Node 1 -->
                <FrameLayout
                    android:id="@+id/hudStarNode1"
                    android:layout_width="@dimen/dp_18"
                    android:layout_height="@dimen/dp_18"
                    android:layout_gravity="start|center_vertical"
                    android:background="@drawable/bg_hud_star_node">

                    <ImageView
                        android:id="@+id/hudStar1"
                        android:layout_width="@dimen/dp_11"
                        android:layout_height="@dimen/dp_11"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_star_empty" />
                </FrameLayout>

                <!-- Milestone Node 2 -->
                <FrameLayout
                    android:id="@+id/hudStarNode2"
                    android:layout_width="@dimen/dp_18"
                    android:layout_height="@dimen/dp_18"
                    android:layout_gravity="start|center_vertical"
                    android:background="@drawable/bg_hud_star_node">

                    <ImageView
                        android:id="@+id/hudStar2"
                        android:layout_width="@dimen/dp_11"
                        android:layout_height="@dimen/dp_11"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_star_empty" />
                </FrameLayout>

                <!-- Milestone Node 3 -->
                <FrameLayout
                    android:id="@+id/hudStarNode3"
                    android:layout_width="@dimen/dp_20"
                    android:layout_height="@dimen/dp_20"
                    android:layout_gravity="start|center_vertical"
                    android:background="@drawable/bg_hud_star_node">

                    <ImageView
                        android:id="@+id/hudStar3"
                        android:layout_width="@dimen/dp_13"
                        android:layout_height="@dimen/dp_13"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_star_empty" />
                </FrameLayout>
            </FrameLayout>

            <!-- Target Objective Info Plaque / Cartridge -->
            <LinearLayout
                android:id="@+id/layoutObjectiveBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_badge_objective"
                android:layout_marginTop="@dimen/dp_4"
                android:paddingStart="@dimen/dp_10"
                android:paddingEnd="@dimen/dp_12"
                android:paddingTop="@dimen/dp_4"
                android:paddingBottom="@dimen/dp_6">

                <ImageView
                    android:id="@+id/ivObjectiveIcon"
                    android:layout_width="@dimen/dp_16"
                    android:layout_height="@dimen/dp_16"
                    android:layout_marginEnd="@dimen/dp_6"
                    android:src="@drawable/ic_target_bullseye"
                    android:contentDescription="Target" />

                <TextView
                    android:id="@+id/tvObjectiveBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TARGET: DROP 15 BUBBLES (0/15)"
                    android:textColor="#FFFFFF"
                    android:textSize="@dimen/sp_11"
                    android:textStyle="bold"
                    android:letterSpacing="0.04"
                    android:shadowColor="#B0000000"
                    android:shadowDx="1"
                    android:shadowDy="2"
                    android:shadowRadius="3" />
            </LinearLayout>
        </LinearLayout>

        <!-- Symmetrical Right Spacer to balance btnPause (46dp) and keep Center HUD perfectly centered -->
        <View
            android:layout_width="@dimen/dp_46"
            android:layout_height="@dimen/dp_46"
            android:visibility="invisible" />

        <!-- Shots Remaining Badge (Hidden from top HUD as redesigned counter is on nextBubble) -->
        <LinearLayout
            android:id="@+id/layoutShots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone"
            android:background="@drawable/bg_button_glossy_green"
            android:paddingStart="@dimen/dp_12"
            android:paddingEnd="@dimen/dp_12"
            android:paddingTop="@dimen/dp_3"
            android:paddingBottom="@dimen/dp_5">

            <TextView
                android:id="@+id/tvShotsCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="25"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/sp_18"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvShotsLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SHOTS"
                android:textColor="#E0FFFFFF"
                android:textSize="@dimen/sp_9"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

    <!-- Bottom Boosters Bar (Clean horizontal row of 4 mod boosters with bubble count badges) -->
    <LinearLayout
        android:id="@+id/bottomBoosters"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="@dimen/dp_12"
        android:paddingEnd="@dimen/dp_12"
        android:paddingTop="@dimen/dp_6"
        android:paddingBottom="@dimen/dp_25">
        <!-- Fireball Booster -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center">

            <FrameLayout
                android:id="@+id/layoutBoosterFireball"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false">

                <ImageButton
                    android:id="@+id/btnBoosterFireball"
                    android:layout_width="@dimen/dp_50"
                    android:layout_height="@dimen/dp_50"
                    android:background="@drawable/bg_circle_transparent"
                    android:scaleType="fitCenter"
                    android:padding="@dimen/dp_2"
                    android:src="@drawable/fireball_bubble"
                    android:contentDescription="Fireball Booster" />

                <!-- Bubble badge for count -->
                <TextView
                    android:id="@+id/tvCountFireball"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:minWidth="@dimen/dp_18"
                    android:minHeight="@dimen/dp_18"
                    android:gravity="center"
                    android:paddingStart="@dimen/dp_4"
                    android:paddingEnd="@dimen/dp_4"
                    android:background="@drawable/bg_booster_badge"
                    android:text="∞"
                    android:textColor="#FFFFFF"
                    android:textSize="@dimen/sp_10"
                    android:textStyle="bold"
                    android:elevation="@dimen/dp_6" />
            </FrameLayout>
        </LinearLayout>

        <!-- Rainbow Booster -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center">

            <FrameLayout
                android:id="@+id/layoutBoosterRainbow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false">

                <ImageButton
                    android:id="@+id/btnBoosterRainbow"
                    android:layout_width="@dimen/dp_50"
                    android:layout_height="@dimen/dp_50"
                    android:background="@drawable/bg_circle_transparent"
                    android:scaleType="fitCenter"
                    android:padding="@dimen/dp_2"
                    android:src="@drawable/rainbow_bubble"
                    android:contentDescription="Rainbow Booster" />

                <!-- Bubble badge for count -->
                <TextView
                    android:id="@+id/tvCountRainbow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:minWidth="@dimen/dp_18"
                    android:minHeight="@dimen/dp_18"
                    android:gravity="center"
                    android:paddingStart="@dimen/dp_4"
                    android:paddingEnd="@dimen/dp_4"
                    android:background="@drawable/bg_booster_badge"
                    android:text="∞"
                    android:textColor="#FFFFFF"
                    android:textSize="@dimen/sp_10"
                    android:textStyle="bold"
                    android:elevation="@dimen/dp_6" />
            </FrameLayout>
        </LinearLayout>



        <!-- Lightning Booster -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center">

            <FrameLayout
                android:id="@+id/layoutBoosterLightning"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false">

                <ImageButton
                    android:id="@+id/btnBoosterLightning"
                    android:layout_width="@dimen/dp_50"
                    android:layout_height="@dimen/dp_50"
                    android:background="@drawable/bg_circle_transparent"
                    android:scaleType="fitCenter"
                    android:padding="@dimen/dp_2"
                    android:src="@drawable/lightning_bubble"
                    android:contentDescription="Lightning Booster" />

                <!-- Bubble badge for count -->
                <TextView
                    android:id="@+id/tvCountLightning"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:minWidth="@dimen/dp_18"
                    android:minHeight="@dimen/dp_18"
                    android:gravity="center"
                    android:paddingStart="@dimen/dp_4"
                    android:paddingEnd="@dimen/dp_4"
                    android:background="@drawable/bg_booster_badge"
                    android:text="∞"
                    android:textColor="#FFFFFF"
                    android:textSize="@dimen/sp_10"
                    android:textStyle="bold"
                    android:elevation="@dimen/dp_6" />
            </FrameLayout>
        </LinearLayout>

        <!-- Bomb Booster -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center">

            <FrameLayout
                android:id="@+id/layoutBoosterBomb"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false">

                <ImageButton
                    android:id="@+id/btnBoosterBomb"
                    android:layout_width="@dimen/dp_50"
                    android:layout_height="@dimen/dp_50"
                    android:background="@drawable/bg_circle_transparent"
                    android:scaleType="fitCenter"
                    android:padding="@dimen/dp_2"
                    android:src="@drawable/bomb_bubble"
                    android:contentDescription="Bomb Booster" />

                <!-- Bubble badge for count -->
                <TextView
                    android:id="@+id/tvCountBomb"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:minWidth="@dimen/dp_18"
                    android:minHeight="@dimen/dp_18"
                    android:gravity="center"
                    android:paddingStart="@dimen/dp_4"
                    android:paddingEnd="@dimen/dp_4"
                    android:background="@drawable/bg_booster_badge"
                    android:text="∞"
                    android:textColor="#FFFFFF"
                    android:textSize="@dimen/sp_10"
                    android:textStyle="bold"
                    android:elevation="@dimen/dp_6" />
            </FrameLayout>
        </LinearLayout>

    </LinearLayout>

</FrameLayout>
