<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_home_saga_world"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Full-Screen World Maps ViewPager2 (Vertical Scrolling) -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPagerWorldMaps"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical" />

    <!-- Top HUD Bar -->
    <LinearLayout
        android:id="@+id/topHudBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/dp_12"
        android:paddingEnd="@dimen/dp_12"
        android:paddingTop="@dimen/dp_36"
        android:paddingBottom="@dimen/dp_8"
        android:clipChildren="false"
        android:elevation="@dimen/dp_10">

        <!-- Player Profile Avatar on Top Left -->
        <FrameLayout
            android:id="@+id/layoutPlayerProfile"
            android:layout_width="@dimen/dp_52"
            android:layout_height="@dimen/dp_52"
            android:background="@drawable/bg_avatar_frame"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/ivHomeAvatar"
                android:layout_width="@dimen/dp_36"
                android:layout_height="@dimen/dp_36"
                android:layout_gravity="center"
                android:src="@drawable/ic_avatar_pin"
                android:contentDescription="Profile" />
        </FrameLayout>

        <!-- Diamonds Counter Pill -->
        <LinearLayout
            android:id="@+id/layoutDiamondsCounter"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_36"
            android:layout_marginStart="@dimen/dp_8"
            android:background="@drawable/bg_hud_pill"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/dp_4"
            android:paddingEnd="@dimen/dp_4"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="@dimen/dp_26"
                android:layout_height="@dimen/dp_26"
                android:src="@drawable/ic_diamond_currency"
                android:contentDescription="Diamonds" />

            <TextView
                android:id="@+id/tvHomeDiamonds"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_6"
                android:layout_marginEnd="@dimen/dp_6"
                android:text="100"
                android:textColor="#0369A1"
                android:textSize="@dimen/sp_14"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="@dimen/dp_20"
                android:layout_height="@dimen/dp_20"
                android:src="@drawable/ic_hud_plus"
                android:contentDescription="Open Diamond Shop" />
        </LinearLayout>

        <!-- Lives / Hearts Counter Pill -->
        <LinearLayout
            android:id="@+id/layoutLivesCounter"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_36"
            android:layout_marginStart="@dimen/dp_8"
            android:background="@drawable/bg_hud_pill"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/dp_4"
            android:paddingEnd="@dimen/dp_4"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="@dimen/dp_24"
                android:layout_height="@dimen/dp_24"
                android:src="@drawable/ic_hud_heart"
                android:contentDescription="Lives" />

            <TextView
                android:id="@+id/tvHomeLives"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_4"
                android:layout_marginEnd="@dimen/dp_6"
                android:text="5 FULL"
                android:textColor="#991B1B"
                android:textSize="@dimen/sp_12"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="@dimen/dp_20"
                android:layout_height="@dimen/dp_20"
                android:src="@drawable/ic_hud_plus"
                android:contentDescription="Add Lives" />
        </LinearLayout>

        <Space
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_1"
            android:layout_weight="1" />

        <!-- Settings Gear Orb on Top Right -->
        <ImageButton
            android:id="@+id/btnMainSettings"
            android:layout_width="@dimen/dp_48"
            android:layout_height="@dimen/dp_48"
            android:background="@android:color/transparent"
            android:scaleType="fitCenter"
            android:src="@drawable/btn_settings_yellow"
            android:contentDescription="Settings" />
    </LinearLayout>

    <!-- Left Floating Badges Column: Star Chest Quest + Endless Mode (Below Quest) -->
    <LinearLayout
        android:id="@+id/layoutLeftBadgesColumn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:layout_marginStart="@dimen/dp_10"
        android:layout_marginTop="@dimen/dp_120"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:elevation="@dimen/dp_8">

        <!-- 1. Star Chest / Milestones Button with Notification Badge -->
        <LinearLayout
            android:id="@+id/layoutStarChestBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:clickable="true"
            android:focusable="true">

            <FrameLayout
                android:layout_width="@dimen/dp_60"
                android:layout_height="@dimen/dp_60"
                >

                <!-- Glowing Amber/Gold Orb -->
                <FrameLayout
                    android:padding="@dimen/dp_10"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_star_chest_badge"
                    >

                    <ImageView
                        android:layout_width="@dimen/dp_36"
                        android:layout_height="@dimen/dp_36"
                        android:layout_gravity="center"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_star_chest_closed"
                        android:contentDescription="Star Chest" />
                </FrameLayout>

                <!-- Notification Badge (Red dot / number of available milestone rewards) -->
                <TextView
                    android:id="@+id/tvStarChestBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="-2dp"
                    android:layout_marginEnd="-2dp"
                    android:minWidth="18dp"
                    android:minHeight="18dp"
                    android:gravity="center"
                    android:background="@drawable/bg_notification_badge_dot"
                    android:text="1"
                    android:textColor="#FFFFFF"
                    android:textSize="@dimen/sp_10"
                    android:textStyle="bold"
                    android:visibility="gone"
                    android:elevation="@dimen/dp_4" />
            </FrameLayout>

            <!-- Pill Tag: STARS -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="-8dp"
                android:background="@drawable/bg_chest_floating_badge"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="@dimen/dp_6"
                android:paddingEnd="@dimen/dp_6"
                android:paddingTop="@dimen/dp_2"
                android:paddingBottom="@dimen/dp_2">
            </LinearLayout>
        </LinearLayout>

        <!-- 2. Redesigned Endless Mode Button (Positioned Directly Below Quest) -->
        <LinearLayout
            android:id="@+id/btnHomeEndlessMode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_16"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:clickable="true"
            android:focusable="true">

            <!-- Glowing Purple/Cyan Endless Orb -->
            <FrameLayout
                android:layout_width="@dimen/dp_50"
                android:layout_height="@dimen/dp_50"
                android:background="@drawable/bg_endless_badge">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="⚡"
                    android:textColor="#FDE047"
                    android:textSize="@dimen/sp_22" />
            </FrameLayout>

            <!-- Pill Tag: ENDLESS -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="-8dp"
                android:background="@drawable/bg_chest_floating_badge"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="@dimen/dp_6"
                android:paddingEnd="@dimen/dp_6"
                android:paddingTop="@dimen/dp_2"
                android:paddingBottom="@dimen/dp_2">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ENDLESS"
                    android:textColor="#FFFFFF"
                    android:textSize="@dimen/sp_10"
                    android:textStyle="bold"
                    android:letterSpacing="0.04" />
            </LinearLayout>

            <!-- Highscore Badge -->
            <TextView
                android:id="@+id/tvEndlessBestTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_2"
                android:background="@drawable/bg_endless_score_tag"
                android:paddingStart="@dimen/dp_6"
                android:paddingEnd="@dimen/dp_6"
                android:paddingTop="@dimen/dp_1"
                android:paddingBottom="@dimen/dp_1"
                android:text="🏆 0"
                android:textColor="#67E8F9"
                android:textSize="@dimen/sp_9"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- World Title Plaque (Positioned cleanly beneath Top HUD) -->
    <LinearLayout
        android:id="@+id/layoutWorldSwitcher"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginTop="@dimen/dp_98"
        android:background="@drawable/bg_world_header_banner"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/dp_16"
        android:paddingEnd="@dimen/dp_16"
        android:paddingTop="@dimen/dp_6"
        android:paddingBottom="@dimen/dp_8"
        android:elevation="@dimen/dp_8"
        android:layout_marginEnd="@dimen/dp_25"
        android:layout_marginBottom="@dimen/dp_35">

        <TextView
            android:id="@+id/tvCurrentWorldTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="WORLD 1 • BUBBLE MEADOWS"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/sp_12"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:shadowColor="#80000000"
            android:shadowDx="1"
            android:shadowDy="2"
            android:shadowRadius="3" />
    </LinearLayout>

    <!-- Puffy Rounded-Triangle Play Button (Matching Example Home Image) -->
    <FrameLayout
        android:id="@+id/btnFloatingPlay"
        android:layout_width="80dp"
        android:layout_height="90dp"
        android:layout_gravity="end|bottom"
        android:layout_marginEnd="@dimen/dp_16"
        android:layout_marginBottom="@dimen/dp_16"
        android:background="@drawable/btn_play_saga"
        android:clickable="true"
        android:focusable="true"
        android:elevation="@dimen/dp_12">

        <!-- Bold White Level Number Centered in Triangle Body -->
        <TextView
            android:id="@+id/tvFloatingLevelNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="4dp"
            android:text="1"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/sp_28"
            android:textStyle="bold"
            android:shadowColor="#14532D"
            android:shadowDx="1"
            android:shadowDy="2"
            android:shadowRadius="3" />
    </FrameLayout>

</FrameLayout>