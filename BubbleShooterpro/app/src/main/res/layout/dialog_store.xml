<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingStart="@dimen/dp_12"
    android:paddingEnd="@dimen/dp_12"
    android:paddingTop="@dimen/dp_12"
    android:paddingBottom="@dimen/dp_12">

    <!-- Main Card Body -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_dialog_frame"
        android:paddingStart="@dimen/dp_16"
        android:paddingEnd="@dimen/dp_16"
        android:paddingTop="@dimen/dp_20"
        android:paddingBottom="@dimen/dp_20">

        <!-- Header Row with Title, Diamonds Pill, and Close -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="@dimen/dp_12">

            <!-- Title -->
            <TextView
                android:id="@+id/tvStoreTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="DIAMOND SHOP"
                android:textColor="#1E293B"
                android:textSize="@dimen/sp_20"
                android:textStyle="bold"
                android:shadowColor="#40FFFFFF"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="1" />

            <!-- Diamonds Counter Pill -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dp_36"
                android:background="@drawable/bg_hud_pill"
                android:gravity="center_vertical"
                android:paddingStart="@dimen/dp_6"
                android:paddingEnd="@dimen/dp_10"
                android:layout_marginEnd="@dimen/dp_10">

                <ImageView
                    android:layout_width="@dimen/dp_24"
                    android:layout_height="@dimen/dp_24"
                    android:src="@drawable/ic_hud_diamond"
                    android:contentDescription="Diamonds" />

                <TextView
                    android:id="@+id/tvStoreDialogDiamonds"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_4"
                    android:text="100"
                    android:textColor="#0369A1"
                    android:textSize="@dimen/sp_14"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Close Button -->
            <ImageButton
                android:id="@+id/btnCloseStore"
                android:layout_width="@dimen/dp_38"
                android:layout_height="@dimen/dp_38"
                android:background="@android:color/transparent"
                android:scaleType="fitCenter"
                android:src="@drawable/btn_close_red"
                android:contentDescription="Close" />
        </LinearLayout>

        <!-- Scrollable Store Inventory -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_420"
            android:scrollbars="none"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- SECTION 1: DIAMOND PACKS -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💎 GET DIAMONDS"
                    android:textColor="#0284C7"
                    android:textSize="@dimen/sp_12"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:layout_marginBottom="@dimen/dp_8" />

                <!-- Row 1: Daily Free + Handful (Pouch) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="@dimen/dp_10">

                    <!-- Daily Free Bonus -->
                    <FrameLayout
                        android:id="@+id/cardBuyDailyFree"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_store_item_card"
                        android:padding="@dimen/dp_10"
                        android:layout_marginEnd="@dimen/dp_6">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center_horizontal">

                            <ImageView
                                android:layout_width="@dimen/dp_44"
                                android:layout_height="@dimen/dp_44"
                                android:src="@drawable/ic_store_gift_free"
                                android:contentDescription="Daily Gift" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Daily Gift"
                                android:textColor="#1E293B"
                                android:textSize="@dimen/sp_12"
                                android:textStyle="bold"
                                android:layout_marginTop="@dimen/dp_4" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="+5 💎"
                                android:textColor="#0284C7"
                                android:textSize="@dimen/sp_13"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/btnBuyDailyFree"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/dp_32"
                                android:layout_marginTop="@dimen/dp_6"
                                android:background="@drawable/bg_store_btn_green"
                                android:gravity="center"
                                android:text="FREE"
                                android:textColor="#FFFFFF"
                                android:textSize="@dimen/sp_12"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </FrameLayout>

                    <!-- Pouch: 150 Diamonds -->
                    <FrameLayout
                        android:id="@+id/cardBuyPouch"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_store_item_card"
                        android:padding="@dimen/dp_10"
                        android:layout_marginStart="@dimen/dp_6">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center_horizontal">

                            <ImageView
                                android:layout_width="@dimen/dp_44"
                                android:layout_height="@dimen/dp_44"
                                android:src="@drawable/ic_store_pouch"
                                android:contentDescription="Diamond Pouch" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Handful"
                                android:textColor="#1E293B"
                                android:textSize="@dimen/sp_12"
                                android:textStyle="bold"
                                android:layout_marginTop="@dimen/dp_4" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="+150 💎"
                                android:textColor="#0284C7"
                                android:textSize="@dimen/sp_13"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/btnBuyPouch"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/dp_32"
                                android:layout_marginTop="@dimen/dp_6"
                                android:background="@drawable/bg_store_btn_amber"
                                android:gravity="center"
                                android:text="₹75"
                                android:textColor="#FFFFFF"
                                android:textSize="@dimen/sp_12"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </FrameLayout>
                </LinearLayout>

                <!-- Row 2: Sack of Gems + Royal Chest -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="@dimen/dp_16">

                    <!-- Sack of Gems: 500 Diamonds (POPULAR) -->
                    <FrameLayout
                        android:id="@+id/cardBuySack"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_store_item_card"
                        android:padding="@dimen/dp_10"
                        android:layout_marginEnd="@dimen/dp_6">

                        <!-- Badge -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_store_badge_red"
                            android:paddingStart="@dimen/dp_6"
                            android:paddingEnd="@dimen/dp_6"
                            android:paddingTop="@dimen/dp_2"
                            android:paddingBottom="@dimen/dp_2"
                            android:text="POPULAR"
                            android:textColor="#FFFFFF"
                            android:textSize="@dimen/sp_9"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center_horizontal">

                            <ImageView
                                android:layout_width="@dimen/dp_44"
                                android:layout_height="@dimen/dp_44"
                                android:src="@drawable/ic_store_sack"
                                android:contentDescription="Diamond Sack" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Sack of Gems"
                                android:textColor="#1E293B"
                                android:textSize="@dimen/sp_12"
                                android:textStyle="bold"
                                android:layout_marginTop="@dimen/dp_4" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="+500 💎"
                                android:textColor="#0284C7"
                                android:textSize="@dimen/sp_13"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/btnBuySack"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/dp_32"
                                android:layout_marginTop="@dimen/dp_6"
                                android:background="@drawable/bg_store_btn_amber"
                                android:gravity="center"
                                android:text="₹250"
                                android:textColor="#FFFFFF"
                                android:textSize="@dimen/sp_12"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </FrameLayout>

                    <!-- Royal Chest: 1500 Diamonds (BEST VALUE) -->
                    <FrameLayout
                        android:id="@+id/cardBuyChest"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_store_item_card_featured"
                        android:padding="@dimen/dp_10"
                        android:layout_marginStart="@dimen/dp_6">

                        <!-- Badge -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_store_badge_red"
                            android:paddingStart="@dimen/dp_6"
                            android:paddingEnd="@dimen/dp_6"
                            android:paddingTop="@dimen/dp_2"
                            android:paddingBottom="@dimen/dp_2"
                            android:text="BEST VALUE"
                            android:textColor="#FFFFFF"
                            android:textSize="@dimen/sp_9"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center_horizontal">

                            <ImageView
                                android:layout_width="@dimen/dp_44"
                                android:layout_height="@dimen/dp_44"
                                android:src="@drawable/ic_store_chest"
                                android:contentDescription="Diamond Chest" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Royal Chest"
                                android:textColor="#92400E"
                                android:textSize="@dimen/sp_12"
                                android:textStyle="bold"
                                android:layout_marginTop="@dimen/dp_4" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="+1,500 💎"
                                android:textColor="#D97706"
                                android:textSize="@dimen/sp_13"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/btnBuyChest"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/dp_32"
                                android:layout_marginTop="@dimen/dp_6"
                                android:background="@drawable/bg_store_btn_amber"
                                android:gravity="center"
                                android:text="₹750"
                                android:textColor="#FFFFFF"
                                android:textSize="@dimen/sp_12"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </FrameLayout>
                </LinearLayout>

                <!-- SECTION 2: BOOSTERS & POWER-UPS -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚡ POWER-UPS (BUY WITH 💎)"
                    android:textColor="#7C3AED"
                    android:textSize="@dimen/sp_12"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:layout_marginBottom="@dimen/dp_8" />

                <!-- Mega Bundle (Featured Big Banner) -->
                <FrameLayout
                    android:id="@+id/cardBuyMegaBundle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_store_item_card_featured"
                    android:padding="@dimen/dp_10"
                    android:layout_marginBottom="@dimen/dp_10">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_store_badge_emerald"
                        android:paddingStart="@dimen/dp_6"
                        android:paddingEnd="@dimen/dp_6"
                        android:paddingTop="@dimen/dp_2"
                        android:paddingBottom="@dimen/dp_2"
                        android:text="MEGA BUNDLE"
                        android:textColor="#FFFFFF"
                        android:textSize="@dimen/sp_9"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingTop="@dimen/dp_8">

                        <ImageView
                            android:layout_width="@dimen/dp_48"
                            android:layout_height="@dimen/dp_48"
                            android:src="@drawable/ic_store_bundle"
                            android:contentDescription="Mega Bundle" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="@dimen/dp_10">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Ultimate Power Pack"
                                android:textColor="#92400E"
                                android:textSize="@dimen/sp_13"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="2x Each Booster + Full Lives ❤️"
                                android:textColor="#64748B"
                                android:textSize="@dimen/sp_11" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/btnBuyMegaBundle"
                            android:layout_width="@dimen/dp_80"
                            android:layout_height="@dimen/dp_36"
                            android:background="@drawable/bg_store_btn_amber"
                            android:gravity="center"
                            android:text="120 💎"
                            android:textColor="#FFFFFF"
                            android:textSize="@dimen/sp_13"
                            android:textStyle="bold" />
                    </LinearLayout>
                </FrameLayout>

                <!-- Boosters Row: Bomb & Fireball -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="@dimen/dp_10">

                    <!-- Bomb Booster (3x) -->
                    <LinearLayout
                        android:id="@+id/cardBuyBomb"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_store_item_card"
                        android:orientation="vertical"
                        android:gravity="center_horizontal"
                        android:padding="@dimen/dp_8"
                        android:layout_marginEnd="@dimen/dp_4">

                        <ImageView
                            android:layout_width="@dimen/dp_36"
                            android:layout_height="@dimen/dp_36"
                            android:src="@drawable/bomb_bubble"
                            android:contentDescription="Bomb Booster" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Bomb 3x"
                            android:textColor="#1E293B"
                            android:textSize="@dimen/sp_12"
                            android:textStyle="bold"
                            android:layout_marginTop="@dimen/dp_2" />

                        <TextView
                            android:id="@+id/btnBuyBomb"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/dp_30"
                            android:layout_marginTop="@dimen/dp_4"
                            android:background="@drawable/bg_store_btn_green"
                            android:gravity="center"
                            android:text="40 💎"
                            android:textColor="#FFFFFF"
                            android:textSize="@dimen/sp_12"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Fireball Booster (3x) -->
                    <LinearLayout
                        android:id="@+id/cardBuyFireball"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_store_item_card"
                        android:orientation="vertical"
                        android:gravity="center_horizontal"
                        android:padding="@dimen/dp_8"
                        android:layout_marginStart="@dimen/dp_4">

                        <ImageView
                            android:layout_width="@dimen/dp_36"
                            android:layout_height="@dimen/dp_36"
                            android:src="@drawable/fireball_bubble"
                            android:contentDescription="Fireball Booster" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Fireball 3x"
                            android:textColor="#1E293B"
                            android:textSize="@dimen/sp_12"
                            android:textStyle="bold"
                            android:layout_marginTop="@dimen/dp_2" />

                        <TextView
                            android:id="@+id/btnBuyFireball"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/dp_30"
                            android:layout_marginTop="@dimen/dp_4"
                            android:background="@drawable/bg_store_btn_green"
                            android:gravity="center"
                            android:text="40 💎"
                            android:textColor="#FFFFFF"
                            android:textSize="@dimen/sp_12"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Boosters Row: Lightning & Rainbow -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="@dimen/dp_16">

                    <!-- Lightning Booster (3x) -->
                    <LinearLayout
                        android:id="@+id/cardBuyLightning"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_store_item_card"
                        android:orientation="vertical"
                        android:gravity="center_horizontal"
                        android:padding="@dimen/dp_8"
                        android:layout_marginEnd="@dimen/dp_4">

                        <ImageView
                            android:layout_width="@dimen/dp_36"
                            android:layout_height="@dimen/dp_36"
                            android:src="@drawable/lightning_bubble"
                            android:contentDescription="Lightning Booster" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Lightning 3x"
                            android:textColor="#1E293B"
                            android:textSize="@dimen/sp_12"
                            android:textStyle="bold"
                            android:layout_marginTop="@dimen/dp_2" />

                        <TextView
                            android:id="@+id/btnBuyLightning"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/dp_30"
                            android:layout_marginTop="@dimen/dp_4"
                            android:background="@drawable/bg_store_btn_green"
                            android:gravity="center"
                            android:text="40 💎"
                            android:textColor="#FFFFFF"
                            android:textSize="@dimen/sp_12"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Rainbow Booster (3x) -->
                    <LinearLayout
                        android:id="@+id/cardBuyRainbow"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_store_item_card"
                        android:orientation="vertical"
                        android:gravity="center_horizontal"
                        android:padding="@dimen/dp_8"
                        android:layout_marginStart="@dimen/dp_4">

                        <ImageView
                            android:layout_width="@dimen/dp_36"
                            android:layout_height="@dimen/dp_36"
                            android:src="@drawable/rainbow_bubble"
                            android:contentDescription="Rainbow Booster" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Rainbow 3x"
                            android:textColor="#1E293B"
                            android:textSize="@dimen/sp_12"
                            android:textStyle="bold"
                            android:layout_marginTop="@dimen/dp_2" />

                        <TextView
                            android:id="@+id/btnBuyRainbow"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/dp_30"
                            android:layout_marginTop="@dimen/dp_4"
                            android:background="@drawable/bg_store_btn_green"
                            android:gravity="center"
                            android:text="50 💎"
                            android:textColor="#FFFFFF"
                            android:textSize="@dimen/sp_12"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- SECTION 3: LIVES & HEARTS -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="❤️ LIVES &amp; HEARTS"
                    android:textColor="#E11D48"
                    android:textSize="@dimen/sp_12"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:layout_marginBottom="@dimen/dp_8" />

                <!-- Lives Refill Banner -->
                <LinearLayout
                    android:id="@+id/cardBuyLives"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_store_item_card"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="@dimen/dp_10">

                    <ImageView
                        android:layout_width="@dimen/dp_40"
                        android:layout_height="@dimen/dp_40"
                        android:src="@drawable/ic_hud_heart"
                        android:contentDescription="Refill Lives" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="@dimen/dp_10">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Full Lives Refill"
                            android:textColor="#1E293B"
                            android:textSize="@dimen/sp_13"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvStoreLivesStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Instant 5/5 Hearts"
                            android:textColor="#64748B"
                            android:textSize="@dimen/sp_11" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/btnBuyLives"
                        android:layout_width="@dimen/dp_80"
                        android:layout_height="@dimen/dp_34"
                        android:background="@drawable/bg_store_btn_green"
                        android:gravity="center"
                        android:text="25 💎"
                        android:textColor="#FFFFFF"
                        android:textSize="@dimen/sp_12"
                        android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

</FrameLayout>
