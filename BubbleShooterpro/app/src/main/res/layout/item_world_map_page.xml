<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutWorldContent"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Full-screen edge-to-edge background (No scrolling, no zooming in) -->
    <ImageView
        android:id="@+id/ivWorldBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="World Map Background" />

    <!-- Overlay container for Level Orbs and Gift Chests -->
    <FrameLayout
        android:id="@+id/layoutNodesOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false" />

    <!-- Locked World Vignette & Lock Overlay (Clean, no clouds) -->
    <FrameLayout
        android:id="@+id/layoutWorldLockedOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#880F172A"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <!-- Center Suspense Lock Container -->
        <LinearLayout
            android:id="@+id/layoutLockedCenterCard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="@dimen/dp_24"
            android:paddingEnd="@dimen/dp_24"
            android:paddingTop="@dimen/dp_20"
            android:paddingBottom="@dimen/dp_20">

            <ImageView
                android:id="@+id/ivLockedBigPadlock"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_gravity="center"
                android:layout_marginBottom="@dimen/dp_12"
                android:src="@drawable/ic_world_golden_lock"
                android:contentDescription="World Locked" />

            <!-- World Title -->
            <TextView
                android:id="@+id/tvLockedWorldTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:shadowColor="#CC000000"
                android:shadowDx="0"
                android:shadowDy="3"
                android:shadowRadius="6"
                android:text="WORLD 2"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/sp_22"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvLockedWorldSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_2"
                android:gravity="center"
                android:shadowColor="#CC000000"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="4"
                android:text="Candy Kingdom"
                android:textColor="#FDE047"
                android:textSize="@dimen/sp_15"
                android:textStyle="bold" />

            <!-- Unlock Requirement Pill Badge -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_14"
                android:background="@drawable/bg_world_locked_pill"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="@dimen/dp_18"
                android:paddingEnd="@dimen/dp_18"
                android:paddingTop="@dimen/dp_8"
                android:paddingBottom="@dimen/dp_8">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔒 "
                    android:textSize="@dimen/sp_13" />

                <TextView
                    android:id="@+id/tvLockedUnlockRequirement"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="UNLOCK AT LEVEL 21"
                    android:textColor="#FEF08A"
                    android:textSize="@dimen/sp_12"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>

    </FrameLayout>

</FrameLayout>
