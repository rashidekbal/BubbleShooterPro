<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingStart="@dimen/dp_16"
    android:paddingEnd="@dimen/dp_16"
    android:paddingTop="@dimen/dp_12"
    android:paddingBottom="@dimen/dp_12">

    <!-- Main Dialog Card Body -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:background="@drawable/bg_dialog_frame"
        android:paddingStart="@dimen/dp_16"
        android:paddingEnd="@dimen/dp_16"
        android:paddingTop="@dimen/dp_48"
        android:paddingBottom="@dimen/dp_24">

        <!-- Top Profile Info (Avatar Preview & Name Input) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="@dimen/dp_14">

            <!-- Selected Avatar Preview -->
            <FrameLayout
                android:layout_width="@dimen/dp_68"
                android:layout_height="@dimen/dp_68"
                android:background="@drawable/bg_avatar_frame">

                <ImageView
                    android:id="@+id/ivSelectedAvatarPreview"
                    android:layout_width="@dimen/dp_48"
                    android:layout_height="@dimen/dp_48"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_avatar_pin"
                    android:contentDescription="Avatar Preview" />
            </FrameLayout>

            <!-- Name Input Field -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/dp_14"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Your Name:"
                    android:textColor="#92400E"
                    android:textSize="@dimen/sp_14"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_44"
                    android:layout_marginTop="@dimen/dp_4"
                    android:background="@drawable/bg_dialog_inset_panel"
                    android:gravity="center_vertical"
                    android:paddingStart="@dimen/dp_12"
                    android:paddingEnd="@dimen/dp_12">

                    <EditText
                        android:id="@+id/etPlayerName"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:autofillHints="personGivenName"
                        android:background="@android:color/transparent"
                        android:hint="Player Name"
                        android:inputType="textPersonName"
                        android:maxLength="16"
                        android:textColor="#1E293B"
                        android:textSize="@dimen/sp_15"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✏️"
                        android:textSize="@dimen/sp_16" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Section Header: Choose Avatar -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Choose Avatar:"
            android:textColor="#92400E"
            android:textSize="@dimen/sp_14"
            android:textStyle="bold"
            android:layout_marginBottom="@dimen/dp_6" />

        <!-- Avatar Selection Grid (8 Predefined Avatars) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvAvatarChoices"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:overScrollMode="never"
            android:clipToPadding="false"
            android:layout_marginBottom="@dimen/dp_16" />

        <!-- Big Glossy Green Confirm Button -->
        <Button
            android:id="@+id/btnProfileConfirm"
            android:layout_width="@dimen/dp_200"
            android:layout_height="@dimen/dp_54"
            android:background="@drawable/btn_pill_blank_green"
            android:text="Confirm"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/sp_18"
            android:textStyle="bold"
            android:shadowColor="#80000000"
            android:shadowDx="1"
            android:shadowDy="2"
            android:shadowRadius="3" />

    </LinearLayout>

    <!-- Top Curved Blue Header Plaque ("Edit Profile") -->
    <LinearLayout
        android:layout_width="@dimen/dp_200"
        android:layout_height="@dimen/dp_46"
        android:layout_gravity="top|center_horizontal"
        android:background="@drawable/bg_dialog_header_plaque"
        android:gravity="center"
        android:elevation="@dimen/dp_4">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Edit Profile"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/sp_20"
            android:textStyle="bold"
            android:shadowColor="#B0000000"
            android:shadowDx="1"
            android:shadowDy="2"
            android:shadowRadius="4" />
    </LinearLayout>

    <!-- Top-Right Glossy Red Close Button -->
    <ImageButton
        android:id="@+id/btnCloseProfile"
        android:layout_width="@dimen/dp_44"
        android:layout_height="@dimen/dp_44"
        android:layout_gravity="top|end"
        android:layout_marginTop="@dimen/dp_2"
        android:layout_marginEnd="@dimen/dp_4"
        android:background="@android:color/transparent"
        android:scaleType="fitCenter"
        android:src="@drawable/btn_close_red"
        android:elevation="@dimen/dp_6"
        android:contentDescription="Close" />

</FrameLayout>
