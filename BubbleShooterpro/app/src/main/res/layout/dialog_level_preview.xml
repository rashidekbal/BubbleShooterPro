<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingStart="@dimen/dp_16"
    android:paddingEnd="@dimen/dp_16"
    android:paddingTop="@dimen/dp_12"
    android:paddingBottom="@dimen/dp_12">

    <!-- Main Dialog Card Body -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:background="@drawable/bg_dialog_frame"
        android:paddingStart="@dimen/dp_16"
        android:paddingEnd="@dimen/dp_16"
        android:paddingTop="@dimen/dp_48"
        android:paddingBottom="@dimen/dp_24">

        <!-- World / Biome Subtitle -->
        <TextView
            android:id="@+id/tvPreviewWorld"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="WORLD 1 • BUBBLE MEADOWS"
            android:textColor="#3B82F6"
            android:textSize="@dimen/sp_12"
            android:textStyle="bold"
            android:letterSpacing="0.1" />

        <!-- 3 Stars Target Milestones -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="@dimen/dp_8"
            android:layout_marginBottom="@dimen/dp_12">

            <ImageView
                android:id="@+id/ivPreviewStar1"
                android:layout_width="@dimen/dp_36"
                android:layout_height="@dimen/dp_36"
                android:src="@drawable/ic_star_filled"
                android:contentDescription="Star 1" />

            <ImageView
                android:id="@+id/ivPreviewStar2"
                android:layout_width="@dimen/dp_44"
                android:layout_height="@dimen/dp_44"
                android:layout_marginStart="@dimen/dp_8"
                android:layout_marginEnd="@dimen/dp_8"
                android:src="@drawable/ic_star_empty"
                android:contentDescription="Star 2" />

            <ImageView
                android:id="@+id/ivPreviewStar3"
                android:layout_width="@dimen/dp_36"
                android:layout_height="@dimen/dp_36"
                android:src="@drawable/ic_star_empty"
                android:contentDescription="Star 3" />
        </LinearLayout>

        <!-- Objective Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_dialog_inset_panel"
            android:paddingStart="@dimen/dp_16"
            android:paddingEnd="@dimen/dp_16"
            android:paddingTop="@dimen/dp_12"
            android:paddingBottom="@dimen/dp_12"
            android:layout_marginBottom="@dimen/dp_14">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TARGET OBJECTIVE"
                android:textColor="#64748B"
                android:textSize="@dimen/sp_10"
                android:textStyle="bold"
                android:letterSpacing="0.1" />

            <TextView
                android:id="@+id/tvPreviewObjective"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_2"
                android:text="Pop all bubbles on the board!"
                android:textColor="#1E293B"
                android:textSize="@dimen/sp_14"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Pre-game Boosters Selection -->
        <TextView
            android:id="@+id/tvSelectBoostersHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SELECT A BOOSTER (FIRST SHOT)"
            android:textColor="#64748B"
            android:textSize="@dimen/sp_11"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:layout_marginBottom="@dimen/dp_8" />

        <LinearLayout
            android:id="@+id/layoutBoostersRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_marginBottom="@dimen/dp_18">

            <!-- Rainbow Booster Container -->
            <FrameLayout
                android:id="@+id/layoutPreviewBoosterRainbow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false">

                <!-- Selection Ring -->
                <View
                    android:id="@+id/ringBoosterRainbow"
                    android:layout_width="@dimen/dp_60"
                    android:layout_height="@dimen/dp_60"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_booster_selected_ring"
                    android:visibility="gone" />

                <!-- Orb Button -->
                <FrameLayout
                    android:id="@+id/btnToggleBoosterRainbow"
                    android:layout_width="@dimen/dp_50"
                    android:layout_height="@dimen/dp_50"
                    android:layout_gravity="center"
                    android:background="@drawable/btn_orb_blank_yellow"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="@dimen/dp_32"
                        android:layout_height="@dimen/dp_32"
                        android:layout_gravity="center"
                        android:src="@drawable/rainbow_bubble"
                        android:contentDescription="Rainbow Booster" />
                </FrameLayout>

                <!-- Checkmark badge (visible when selected) -->
                <ImageView
                    android:id="@+id/ivCheckPreviewRainbow"
                    android:layout_width="@dimen/dp_20"
                    android:layout_height="@dimen/dp_20"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="@dimen/dp_2"
                    android:layout_marginEnd="@dimen/dp_2"
                    android:src="@drawable/ic_checkmark_badge"
                    android:elevation="@dimen/dp_6"
                    android:visibility="gone" />

                <!-- Count Badge -->
                <TextView
                    android:id="@+id/tvCountPreviewRainbow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:minWidth="@dimen/dp_20"
                    android:minHeight="@dimen/dp_20"
                    android:gravity="center"
                    android:paddingStart="@dimen/dp_5"
                    android:paddingEnd="@dimen/dp_5"
                    android:background="@drawable/bg_booster_badge_available"
                    android:textColor="#FFFFFF"
                    android:textSize="@dimen/sp_10"
                    android:textStyle="bold"
                    android:elevation="@dimen/dp_6"
                    android:text="1" />
            </FrameLayout>

            <!-- Fireball Booster Container -->
            <FrameLayout
                android:id="@+id/layoutPreviewBoosterFireball"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_12"
                android:clipChildren="false"
                android:clipToPadding="false">

                <!-- Selection Ring -->
                <View
                    android:id="@+id/ringBoosterFireball"
                    android:layout_width="@dimen/dp_60"
                    android:layout_height="@dimen/dp_60"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_booster_selected_ring"
                    android:visibility="gone" />

                <!-- Orb Button -->
                <FrameLayout
                    android:id="@+id/btnToggleBoosterFireball"
                    android:layout_width="@dimen/dp_50"
                    android:layout_height="@dimen/dp_50"
                    android:layout_gravity="center"
                    android:background="@drawable/btn_orb_blank_orange"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="@dimen/dp_32"
                        android:layout_height="@dimen/dp_32"
                        android:layout_gravity="center"
                        android:src="@drawable/fireball_bubble"
                        android:contentDescription="Fireball Booster" />
                </FrameLayout>

                <!-- Checkmark badge (visible when selected) -->
                <ImageView
                    android:id="@+id/ivCheckPreviewFireball"
                    android:layout_width="@dimen/dp_20"
                    android:layout_height="@dimen/dp_20"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="@dimen/dp_2"
                    android:layout_marginEnd="@dimen/dp_2"
                    android:src="@drawable/ic_checkmark_badge"
                    android:elevation="@dimen/dp_6"
                    android:visibility="gone" />

                <!-- Count Badge -->
                <TextView
                    android:id="@+id/tvCountPreviewFireball"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:minWidth="@dimen/dp_20"
                    android:minHeight="@dimen/dp_20"
                    android:gravity="center"
                    android:paddingStart="@dimen/dp_5"
                    android:paddingEnd="@dimen/dp_5"
                    android:background="@drawable/bg_booster_badge_available"
                    android:textColor="#FFFFFF"
                    android:textSize="@dimen/sp_10"
                    android:textStyle="bold"
                    android:elevation="@dimen/dp_6"
                    android:text="1" />
            </FrameLayout>

            <!-- Lightning Booster Container -->
            <FrameLayout
                android:id="@+id/layoutPreviewBoosterLightning"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_12"
                android:clipChildren="false"
                android:clipToPadding="false">

                <!-- Selection Ring -->
                <View
                    android:id="@+id/ringBoosterLightning"
                    android:layout_width="@dimen/dp_60"
                    android:layout_height="@dimen/dp_60"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_booster_selected_ring"
                    android:visibility="gone" />

                <!-- Orb Button -->
                <FrameLayout
                    android:id="@+id/btnToggleBoosterLightning"
                    android:layout_width="@dimen/dp_50"
                    android:layout_height="@dimen/dp_50"
                    android:layout_gravity="center"
                    android:background="@drawable/btn_orb_blank_blue"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="@dimen/dp_32"
                        android:layout_height="@dimen/dp_32"
                        android:layout_gravity="center"
                        android:src="@drawable/lightning_bubble"
                        android:contentDescription="Lightning Booster" />
                </FrameLayout>

                <!-- Checkmark badge (visible when selected) -->
                <ImageView
                    android:id="@+id/ivCheckPreviewLightning"
                    android:layout_width="@dimen/dp_20"
                    android:layout_height="@dimen/dp_20"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="@dimen/dp_2"
                    android:layout_marginEnd="@dimen/dp_2"
                    android:src="@drawable/ic_checkmark_badge"
                    android:elevation="@dimen/dp_6"
                    android:visibility="gone" />

                <!-- Count Badge -->
                <TextView
                    android:id="@+id/tvCountPreviewLightning"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:minWidth="@dimen/dp_20"
                    android:minHeight="@dimen/dp_20"
                    android:gravity="center"
                    android:paddingStart="@dimen/dp_5"
                    android:paddingEnd="@dimen/dp_5"
                    android:background="@drawable/bg_booster_badge_available"
                    android:textColor="#FFFFFF"
                    android:textSize="@dimen/sp_10"
                    android:textStyle="bold"
                    android:elevation="@dimen/dp_6"
                    android:text="1" />
            </FrameLayout>

            <!-- Bomb Booster Container -->
            <FrameLayout
                android:id="@+id/layoutPreviewBoosterBomb"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_12"
                android:clipChildren="false"
                android:clipToPadding="false">

                <!-- Selection Ring -->
                <View
                    android:id="@+id/ringBoosterBomb"
                    android:layout_width="@dimen/dp_60"
                    android:layout_height="@dimen/dp_60"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_booster_selected_ring"
                    android:visibility="gone" />

                <!-- Orb Button -->
                <FrameLayout
                    android:id="@+id/btnToggleBoosterBomb"
                    android:layout_width="@dimen/dp_50"
                    android:layout_height="@dimen/dp_50"
                    android:layout_gravity="center"
                    android:background="@drawable/btn_orb_blank_red"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="@dimen/dp_32"
                        android:layout_height="@dimen/dp_32"
                        android:layout_gravity="center"
                        android:src="@drawable/bomb_bubble"
                        android:contentDescription="Bomb Booster" />
                </FrameLayout>

                <!-- Checkmark badge (visible when selected) -->
                <ImageView
                    android:id="@+id/ivCheckPreviewBomb"
                    android:layout_width="@dimen/dp_20"
                    android:layout_height="@dimen/dp_20"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="@dimen/dp_2"
                    android:layout_marginEnd="@dimen/dp_2"
                    android:src="@drawable/ic_checkmark_badge"
                    android:elevation="@dimen/dp_6"
                    android:visibility="gone" />

                <!-- Count Badge -->
                <TextView
                    android:id="@+id/tvCountPreviewBomb"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:minWidth="@dimen/dp_20"
                    android:minHeight="@dimen/dp_20"
                    android:gravity="center"
                    android:paddingStart="@dimen/dp_5"
                    android:paddingEnd="@dimen/dp_5"
                    android:background="@drawable/bg_booster_badge_available"
                    android:textColor="#FFFFFF"
                    android:textSize="@dimen/sp_10"
                    android:textStyle="bold"
                    android:elevation="@dimen/dp_6"
                    android:text="1" />
            </FrameLayout>
        </LinearLayout>

        <!-- Big Glossy Green Start Button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnStartLevel"
            android:layout_width="@dimen/dp_220"
            android:layout_height="@dimen/dp_56"
            android:background="@drawable/btn_pill_blank_green"
            android:text="@string/play"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/sp_20"
            android:textStyle="bold"
            android:letterSpacing="0.04"
            android:shadowColor="#80000000"
            android:shadowDx="1"
            android:shadowDy="2"
            android:shadowRadius="3" />

    </LinearLayout>

    <!-- Top Curved Blue Header Plaque ("Level X") -->
    <LinearLayout
        android:layout_width="@dimen/dp_200"
        android:layout_height="@dimen/dp_46"
        android:layout_gravity="top|center_horizontal"
        android:background="@drawable/bg_dialog_header_plaque"
        android:gravity="center"
        android:elevation="@dimen/dp_4">

        <TextView
            android:id="@+id/tvPreviewLevel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LEVEL 1"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/sp_20"
            android:textStyle="bold"
            android:shadowColor="#B0000000"
            android:shadowDx="1"
            android:shadowDy="2"
            android:shadowRadius="4" />
    </LinearLayout>

    <!-- Top-Right Glossy Red Close Button -->
    <ImageButton
        android:id="@+id/btnClosePreview"
        android:layout_width="@dimen/dp_44"
        android:layout_height="@dimen/dp_44"
        android:layout_gravity="top|end"
        android:layout_marginTop="@dimen/dp_2"
        android:layout_marginEnd="@dimen/dp_4"
        android:background="@android:color/transparent"
        android:scaleType="fitCenter"
        android:src="@drawable/btn_close_red"
        android:elevation="@dimen/dp_6"
        android:contentDescription="Close" />

</FrameLayout>
