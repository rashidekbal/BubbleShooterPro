<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootBoosterIntroDialog"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingStart="@dimen/dp_16"
    android:paddingEnd="@dimen/dp_16"
    android:paddingTop="@dimen/dp_16"
    android:paddingBottom="@dimen/dp_16">

    <!-- Main Dialog Card Body -->
    <LinearLayout
        android:id="@+id/cardBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:background="@drawable/bg_dialog_frame"
        android:paddingStart="@dimen/dp_20"
        android:paddingEnd="@dimen/dp_20"
        android:paddingTop="@dimen/dp_36"
        android:paddingBottom="@dimen/dp_22">

        <!-- World Tag / Badge -->
        <TextView
            android:id="@+id/tvWorldTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_4"
            android:text="WORLD 2 • CANDY KINGDOM"
            android:textColor="#D97706"
            android:textSize="@dimen/sp_12"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <!-- Booster Icon Container -->
        <FrameLayout
            android:id="@+id/layoutBoosterIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_8"
            android:layout_marginBottom="@dimen/dp_8">

            <ImageView
                android:id="@+id/ivBoosterGlow"
                android:layout_width="@dimen/dp_90"
                android:layout_height="@dimen/dp_90"
                android:layout_gravity="center"
                android:src="@drawable/bg_circle_gold_glow"
                android:alpha="0.6"
                android:contentDescription="@null" />

            <ImageView
                android:id="@+id/ivBoosterIcon"
                android:layout_width="@dimen/dp_68"
                android:layout_height="@dimen/dp_68"
                android:layout_gravity="center"
                android:src="@drawable/bomb_bubble"
                android:contentDescription="Booster Preview" />
        </FrameLayout>

        <!-- Inset Content Panel -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_dialog_inset_panel"
            android:paddingStart="@dimen/dp_16"
            android:paddingEnd="@dimen/dp_16"
            android:paddingTop="@dimen/dp_14"
            android:paddingBottom="@dimen/dp_14">

            <!-- Booster Name -->
            <TextView
                android:id="@+id/tvBoosterName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BOMB BOOSTER"
                android:textColor="#1E293B"
                android:textSize="@dimen/sp_18"
                android:textStyle="bold"
                android:gravity="center" />

            <!-- Booster Description -->
            <TextView
                android:id="@+id/tvBoosterDescription"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_6"
                android:text="Destroys all bubbles in a large area upon impact!"
                android:textColor="#475569"
                android:textSize="@dimen/sp_13"
                android:lineSpacingMultiplier="1.2"
                android:gravity="center" />

            <!-- Gift Callout Pill -->
            <LinearLayout
                android:id="@+id/layoutGiftPill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_10"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="@drawable/bg_hud_pill"
                android:paddingStart="@dimen/dp_12"
                android:paddingEnd="@dimen/dp_12"
                android:paddingTop="@dimen/dp_6"
                android:paddingBottom="@dimen/dp_6">

                <TextView
                    android:id="@+id/tvGiftText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎁 GIFT: +5 Free Boosters Added!"
                    android:textColor="#059669"
                    android:textSize="@dimen/sp_12"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Let's Play Button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnLetsPlay"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_48"
            android:layout_marginTop="@dimen/dp_14"
            android:background="@drawable/btn_pill_blank_green"
            android:text="LET'S PLAY"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/sp_16"
            android:textStyle="bold"
            android:shadowColor="#80000000"
            android:shadowDx="1"
            android:shadowDy="2"
            android:shadowRadius="3"
            android:stateListAnimator="@null" />

    </LinearLayout>

    <!-- Top Curved Header Plaque -->
    <LinearLayout
        android:id="@+id/layoutBoosterPlaque"
        android:layout_width="@dimen/dp_230"
        android:layout_height="@dimen/dp_46"
        android:layout_gravity="top|center_horizontal"
        android:background="@drawable/bg_dialog_header_plaque"
        android:gravity="center"
        android:elevation="@dimen/dp_6">

        <TextView
            android:id="@+id/tvBoosterPlaqueTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NEW BOOSTER!"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/sp_17"
            android:textStyle="bold"
            android:shadowColor="#B0000000"
            android:shadowDx="1"
            android:shadowDy="2"
            android:shadowRadius="3" />
    </LinearLayout>

</FrameLayout>
