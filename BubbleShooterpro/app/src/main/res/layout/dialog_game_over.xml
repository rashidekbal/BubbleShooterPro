<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingStart="@dimen/dp_16"
    android:paddingEnd="@dimen/dp_16"
    android:paddingTop="@dimen/dp_12"
    android:paddingBottom="@dimen/dp_12">

    <!-- Main Dialog Card Body -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:background="@drawable/bg_dialog_frame"
        android:paddingStart="@dimen/dp_16"
        android:paddingEnd="@dimen/dp_16"
        android:paddingTop="@dimen/dp_48"
        android:paddingBottom="@dimen/dp_24">

        <!-- Subtitle Reason -->
        <TextView
            android:id="@+id/tvLoseSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Out of shots! Don't give up!"
            android:textColor="#EF4444"
            android:textSize="@dimen/sp_14"
            android:textStyle="bold"
            android:layout_marginBottom="@dimen/dp_12" />

        <!-- Inset Score Panel -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_dialog_inset_panel"
            android:paddingStart="@dimen/dp_16"
            android:paddingEnd="@dimen/dp_16"
            android:paddingTop="@dimen/dp_14"
            android:paddingBottom="@dimen/dp_14"
            android:layout_marginBottom="@dimen/dp_18">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FINAL SCORE"
                android:textColor="#64748B"
                android:textSize="@dimen/sp_11"
                android:textStyle="bold"
                android:letterSpacing="0.1" />

            <TextView
                android:id="@+id/tvLoseScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_2"
                android:text="1,200"
                android:textColor="#D97706"
                android:textSize="@dimen/sp_30"
                android:textStyle="bold"
                android:shadowColor="#30000000"
                android:shadowDx="1"
                android:shadowDy="2"
                android:shadowRadius="3" />

            <TextView
                android:id="@+id/tvLoseBestScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_2"
                android:text="BEST: 2,450"
                android:textColor="#94A3B8"
                android:textSize="@dimen/sp_12"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- No-Hearts Warning Banner (shown only when lives == 0) -->
        <LinearLayout
            android:id="@+id/layoutNoHeartsWarning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/bg_dialog_inset_panel"
            android:paddingStart="@dimen/dp_12"
            android:paddingEnd="@dimen/dp_12"
            android:paddingTop="@dimen/dp_10"
            android:paddingBottom="@dimen/dp_10"
            android:layout_marginBottom="@dimen/dp_10"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💔"
                android:textSize="@dimen/sp_20"
                android:layout_marginEnd="@dimen/dp_8" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No Hearts Left!"
                    android:textColor="#BE123C"
                    android:textSize="@dimen/sp_13"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvNoHeartsDetail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Get more hearts to keep playing"
                    android:textColor="#64748B"
                    android:textSize="@dimen/sp_11" />
            </LinearLayout>
        </LinearLayout>

        <!-- Action Buttons Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="@dimen/dp_6">

            <!-- Home Orb Button -->
            <ImageButton
                android:id="@+id/btnLoseHome"
                android:layout_width="@dimen/dp_56"
                android:layout_height="@dimen/dp_56"
                android:background="@android:color/transparent"
                android:scaleType="fitCenter"
                android:src="@drawable/btn_home_yellow"
                android:contentDescription="@string/home" />

            <!-- Restart / Retry Orb Button -->
            <ImageButton
                android:id="@+id/btnLoseRetry"
                android:layout_width="@dimen/dp_56"
                android:layout_height="@dimen/dp_56"
                android:layout_marginStart="@dimen/dp_24"
                android:background="@android:color/transparent"
                android:scaleType="fitCenter"
                android:src="@drawable/btn_restart_yellow"
                android:contentDescription="@string/restart" />
        </LinearLayout>

    </LinearLayout>

    <!-- Top Curved Blue Header Plaque ("Try Again" / "Game Over") -->
    <LinearLayout
        android:layout_width="@dimen/dp_200"
        android:layout_height="@dimen/dp_46"
        android:layout_gravity="top|center_horizontal"
        android:background="@drawable/bg_dialog_header_plaque"
        android:gravity="center"
        android:elevation="@dimen/dp_4">

        <TextView
            android:id="@+id/tvLoseTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/game_over"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/sp_20"
            android:textStyle="bold"
            android:shadowColor="#B0000000"
            android:shadowDx="1"
            android:shadowDy="2"
            android:shadowRadius="4" />
    </LinearLayout>

    <!-- Top-Right Glossy Red Close Button -->
    <ImageButton
        android:id="@+id/btnCloseLose"
        android:layout_width="@dimen/dp_44"
        android:layout_height="@dimen/dp_44"
        android:layout_gravity="top|end"
        android:layout_marginTop="@dimen/dp_2"
        android:layout_marginEnd="@dimen/dp_4"
        android:background="@android:color/transparent"
        android:scaleType="fitCenter"
        android:src="@drawable/btn_close_red"
        android:elevation="@dimen/dp_6"
        android:contentDescription="Close" />

</FrameLayout>
